# ─────────────────────────────────────────────────────────────
# North Specs Peptides — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# The storefront runs WITHOUT these using a built-in demo catalog,
# but you need them for auth, orders, and the admin backend.
# ─────────────────────────────────────────────────────────────

# --- Supabase (required for auth, orders, admin) ---
# Find these in your Supabase dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://swcxswuecljpegbrkbqt.supabase.co
NEXT_PUBLIC_SUPABASE_PROJECT_ID=swcxswuecljpegbrkbqt

# Public key (browser-safe). Use EITHER the new publishable key OR the legacy
# anon key — the app reads both names.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret key — SERVER ONLY. Never expose to the browser. Used by admin server
# actions and privileged data seeding. Use EITHER the new secret key OR the
# legacy service-role key — the app reads both names.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_...

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="North Specs Peptides"

# --- Email (Resend) — optional, wire up later ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="North Specs Peptides <orders@northspecs.ca>"

# --- Payments (Stripe) — optional, wire up later ---
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
